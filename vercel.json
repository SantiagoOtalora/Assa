{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/respaldo",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/panel",
      "destination": "/panel.html"
    },
    {
      "source": "/consulta",
      "destination": "/consulta.html"
    },
    {
      "source": "/formulario2",
      "destination": "/formulario2.html"
    }
  ]
}
